{
  "rulebook": [
    {
      "markdown": "../../../../references/options-and-decisions.md",
      "rules": "timing.rules.json"
    }
  ],
  "marker_prefix": "O",
  "check": {
    "files": [
      "**/*.html"
    ]
  },
  "evidence": {
    "ast_grep": "evidence/sgconfig.yml",
    "html": {
      "skip_tags": [
        "ex-mermaid",
        "ex-choice",
        "ex-compare"
      ],
      "text_attributes": {
        "ex-choice": [
          "id",
          "title"
        ],
        "ex-option": [
          "id",
          "title"
        ],
        "ex-mermaid": [
          "id",
          "label"
        ],
        "ex-flow": [
          "label"
        ],
        "ex-callout": [
          "title"
        ],
        "aside": [
          "data-design-item",
          "data-authority",
          "data-rank"
        ]
      }
    },
    "kinds": {
      "section": {
        "html_units": {
          "mode": "unit",
          "units": [
            "section"
          ]
        },
        "max_chars": 50000,
        "fields": {
          "own": {
            "from": "section",
            "text": "own"
          },
          "parent": {
            "from": "section",
            "text": "enclosing_own"
          },
          "full": {
            "from": "section",
            "text": "full"
          },
          "same_file_controls": {
            "from": "same_file",
            "kind": "choice",
            "text": "full"
          }
        }
      },
      "outline": {
        "html_units": {
          "mode": "unit",
          "units": [
            "section"
          ]
        },
        "fields": {}
      },
      "choice": {
        "rule": "native-choice",
        "max_chars": 50000,
        "fields": {
          "control": {
            "from": "capture",
            "regex": "(?s)(.+)"
          },
          "context": {
            "from": "enclosing",
            "kind": "outline",
            "text": "full"
          },
          "direct_heading_match": {
            "from": "inside",
            "rule": "choice-with-direct-heading-boundary"
          },
          "earlier_picture_match": {
            "from": "inside",
            "rule": "choice-with-earlier-section-picture"
          }
        }
      }
    }
  },
  "decision_model": {
    "model": "typesafe/jev-1.14-20261014"
  },
  "limits": {
    "evidence_max_chars": 50000,
    "request_max_chars": 131072,
    "max_model_requests": 100,
    "max_concurrent_requests": 3,
    "max_matches": 20000
  }
}
