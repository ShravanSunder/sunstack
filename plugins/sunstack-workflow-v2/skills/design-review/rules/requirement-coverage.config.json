{
  "rulebook": [
    {
      "markdown": "requirement-coverage.md",
      "rules": "requirement-coverage-html.rules.json"
    },
    {
      "markdown": "requirement-coverage.md",
      "rules": "requirement-coverage-markdown.rules.json"
    }
  ],
  "marker_prefix": "C",
  "check": {
    "files": [
      "**/requirements.html",
      "**/requirements.md",
      "**/specification.html",
      "**/specification.md"
    ]
  },
  "evidence": {
    "ast_grep": "evidence/sgconfig.yml",
    "kinds": {
      "html_requirement": {
        "rule": "html-requirement-definition",
        "fields": {
          "identifier": {
            "from": "capture",
            "regex": "\\sid=[\"'](U[0-9]+)[\"']"
          },
          "requirement": {
            "from": "remainder"
          },
          "specification": {
            "from": "document",
            "path": [
              "specification.html"
            ],
            "rule": "html-page-presence"
          },
          "program_design": {
            "from": "document",
            "path": [
              "program-design.html"
            ],
            "rule": "html-page-presence"
          },
          "verification": {
            "from": "document",
            "path": [
              "verification.html",
              "verification-design.html"
            ],
            "rule": "html-page-presence"
          },
          "all_obligations": {
            "from": "document",
            "path": [
              "specification.html"
            ],
            "rule": "html-obligation-definition"
          },
          "proof_obligations": {
            "from": "document",
            "path": [
              "specification.html"
            ],
            "rule": "html-proof-obligation"
          },
          "verification_rows": {
            "from": "document",
            "path": [
              "verification.html",
              "verification-design.html"
            ],
            "rule": "html-passage",
            "containing": "identifier"
          },
          "trace_rows": {
            "from": "document",
            "path": [
              "program-design.html"
            ],
            "rule": "html-trace-row"
          },
          "shared_observations": {
            "from": "document",
            "path": [
              "verification.html",
              "verification-design.html"
            ],
            "rule": "html-verification-prose"
          }
        }
      },
      "html_obligation": {
        "rule": "html-obligation-definition",
        "fields": {
          "identifier": {
            "from": "capture",
            "regex": "\\sid=[\"'](R[0-9]+[a-z]?)[\"']"
          },
          "obligation": {
            "from": "remainder"
          },
          "program_design": {
            "from": "document",
            "path": [
              "program-design.html"
            ],
            "rule": "html-page-presence"
          },
          "realization_rows": {
            "from": "document",
            "path": [
              "program-design.html"
            ],
            "rule": "html-passage",
            "containing": "identifier"
          }
        }
      },
      "html_requirements_page": {
        "rule": "html-requirements-page",
        "fields": {
          "specification": {
            "from": "document",
            "path": [
              "specification.html"
            ],
            "rule": "html-page-presence"
          },
          "program_design": {
            "from": "document",
            "path": [
              "program-design.html"
            ],
            "rule": "html-page-presence"
          },
          "verification": {
            "from": "document",
            "path": [
              "verification.html",
              "verification-design.html"
            ],
            "rule": "html-page-presence"
          }
        }
      },
      "markdown_requirement": {
        "rule": "markdown-requirement-definition",
        "fields": {
          "identifier": {
            "from": "capture",
            "regex": "^(?:\\|\\s*\\**|#{2,6}\\s+\\**)(U[0-9]+)"
          },
          "requirement": {
            "from": "remainder"
          },
          "specification": {
            "from": "document",
            "path": [
              "specification.md"
            ],
            "rule": "markdown-page-presence"
          },
          "program_design": {
            "from": "document",
            "path": [
              "program-design.md"
            ],
            "rule": "markdown-page-presence"
          },
          "verification": {
            "from": "document",
            "path": [
              "verification.md",
              "verification-design.md"
            ],
            "rule": "markdown-page-presence"
          },
          "all_obligations": {
            "from": "document",
            "path": [
              "specification.md"
            ],
            "rule": "markdown-obligation-unit"
          },
          "proof_obligations": {
            "from": "document",
            "path": [
              "specification.md"
            ],
            "rule": "markdown-proof-obligation"
          },
          "verification_rows": {
            "from": "document",
            "path": [
              "verification.md",
              "verification-design.md"
            ],
            "rule": "markdown-passage",
            "containing": "identifier"
          },
          "trace_rows": {
            "from": "document",
            "path": [
              "program-design.md"
            ],
            "rule": "markdown-trace-row"
          },
          "shared_observations": {
            "from": "document",
            "path": [
              "verification.md",
              "verification-design.md"
            ],
            "rule": "markdown-verification-prose"
          }
        }
      },
      "markdown_obligation": {
        "rule": "markdown-obligation-definition",
        "fields": {
          "identifier": {
            "from": "capture",
            "regex": "^(?:\\|\\s*|[-*+]\\s+|#{2,6}\\s+)?\\**(R[0-9]+[a-z]?)"
          },
          "obligation": {
            "from": "remainder"
          },
          "obligation_body": {
            "from": "next",
            "rule": "markdown-list",
            "count": 1
          },
          "program_design": {
            "from": "document",
            "path": [
              "program-design.md"
            ],
            "rule": "markdown-page-presence"
          },
          "realization_rows": {
            "from": "document",
            "path": [
              "program-design.md"
            ],
            "rule": "markdown-passage",
            "containing": "identifier"
          },
          "requirement_ids": {
            "from": "captures",
            "regex": "\\bU[0-9]+\\b"
          },
          "realization_by_requirement": {
            "from": "document",
            "path": [
              "program-design.md"
            ],
            "rule": "markdown-row-passage",
            "containing": "requirement_ids"
          },
          "realization_blocks": {
            "from": "document",
            "path": [
              "program-design.md"
            ],
            "rule": "markdown-block-lead",
            "containing": "identifier",
            "attach": {
              "until": "markdown-block-boundary",
              "max_siblings": 12
            }
          },
          "realization_items": {
            "from": "document",
            "path": [
              "program-design.md"
            ],
            "rule": "markdown-item-lead",
            "containing": "identifier",
            "attach": {
              "until": "markdown-block-boundary",
              "max_siblings": 12
            }
          },
          "realization_names": {
            "from": "captures",
            "of": "realization_rows",
            "regex": "`([A-Z][A-Za-z0-9]+)`"
          },
          "realization_by_name": {
            "from": "document",
            "path": [
              "program-design.md"
            ],
            "rule": "markdown-block-lead",
            "containing": "realization_names",
            "attach": {
              "until": "markdown-block-boundary",
              "max_siblings": 12
            }
          },
          "realization_name_items": {
            "from": "document",
            "path": [
              "program-design.md"
            ],
            "rule": "markdown-item-lead",
            "containing": "realization_names",
            "attach": {
              "until": "markdown-block-boundary",
              "max_siblings": 12
            }
          },
          "realization_modules": {
            "from": "captures",
            "of": "realization_rows",
            "regex": "\\b([a-z][a-z0-9]*(?:_[a-z0-9]+)+)\\b"
          },
          "realization_diagrams": {
            "from": "document",
            "path": [
              "program-design.md"
            ],
            "rule": "markdown-diagram",
            "containing": "realization_modules"
          }
        }
      },
      "markdown_requirements_page": {
        "rule": "markdown-requirements-page",
        "fields": {
          "specification": {
            "from": "document",
            "path": [
              "specification.md"
            ],
            "rule": "markdown-page-presence"
          },
          "program_design": {
            "from": "document",
            "path": [
              "program-design.md"
            ],
            "rule": "markdown-page-presence"
          },
          "verification": {
            "from": "document",
            "path": [
              "verification.md",
              "verification-design.md"
            ],
            "rule": "markdown-page-presence"
          }
        }
      }
    }
  },
  "decision_model": {
    "model": "jev-latest"
  },
  "limits": {
    "evidence_max_chars": 60000,
    "request_max_chars": 131072,
    "max_input_tokens_per_request": 64000,
    "max_model_requests": 400,
    "max_matches": 20000
  }
}
