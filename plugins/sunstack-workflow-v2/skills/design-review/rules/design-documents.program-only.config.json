{
  "rulebook": [
    {
      "markdown": "../../design-program/SKILL.md",
      "rules": "../../design-program/rules/design-program.rules.json"
    },
    {
      "markdown": "../../design-specification/SKILL.md",
      "rules": "../../design-specification/rules/design-specification.rules.json"
    }
  ],
  "marker_prefix": "D",
  "check": {
    "files": [
      "**/*.html"
    ]
  },
  "evidence": {
    "ast_grep": "evidence/sgconfig.yml",
    "kinds": {
      "entity": {
        "rule": "entity-element",
        "fields": {
          "identifier": {
            "from": "capture",
            "regex": "^<[^>]*\\sid\\s*=\\s*[\"']?(E[0-9]+)[\"'\\s/>]"
          },
          "bindings": {
            "from": "document",
            "path": "program-design.html",
            "rule": "binding-row-text"
          }
        }
      },
      "trace_link": {
        "rule": "trace-link",
        "fields": {
          "links": {
            "from": "target",
            "regex": "^<[^>]*\\shref\\s*=\\s*[\"']?((?:(?:\\./)?[^\"'\\s>/:#]+\\.html)?#[^\"'\\s>]+)",
            "resolve": "path"
          }
        }
      }
    }
  },
  "decision_model": {
    "model": "jev-latest"
  }
}
