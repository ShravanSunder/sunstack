{
  "rulebook": [
    {
      "markdown": "../references/descriptions-and-invocation.md",
      "rules": "descriptions-and-invocation.rules.json"
    }
  ],
  "marker_prefix": "K",
  "check": {
    "files": [
      "plugins/*/skills/*/SKILL.md",
      "plugins/*/skills/*/references/**/*.md",
      "plugins/*/skills/*/rules/*.rules.json"
    ]
  },
  "evidence": {
    "ast_grep": "evidence/sgconfig.yml",
    "kinds": {
      "skill": {
        "rule": "skill",
        "fields": {
          "description": {
            "from": "yaml",
            "key": "description"
          },
          "opening": {
            "from": "same_file",
            "rule": "skill-opening",
            "text": "full"
          }
        }
      },
      "section": {
        "rule": "skill-section",
        "max_chars": 50000,
        "fields": {
          "heading": {
            "from": "first_line"
          },
          "headings": {
            "from": "enclosing",
            "rule": "section-heading"
          },
          "body": {
            "from": "remainder",
            "exclude": {
              "rule": "section-heading"
            }
          },
          "targets": {
            "from": "target",
            "regex": "(?:load|dispatch)\\s+`([^`]+)`",
            "resolve": "path_or_skill",
            "opening_chars": 3000,
            "exclude": {
              "rule": "section-heading"
            }
          }
        }
      },
      "load": {
        "rule": "load",
        "fields": {
          "line": {
            "from": "capture",
            "regex": "(?s)(.+)"
          },
          "targets": {
            "from": "target",
            "regex": "`([^`]+)`",
            "resolve": "path_or_skill",
            "as_kind": "skill"
          },
          "headings": {
            "from": "enclosing",
            "rule": "section-heading"
          },
          "caller_context": {
            "from": "enclosing",
            "rule": "section-heading",
            "text": "full"
          }
        },
        "max_chars": 50000
      },
      "branch": {
        "rule": "branch",
        "fields": {
          "line": {
            "from": "first_line"
          },
          "headings": {
            "from": "enclosing",
            "rule": "section-heading"
          },
          "block": {
            "from": "next",
            "rule": "colon-block",
            "count": 1
          }
        }
      },
      "rule_question": {
        "rule": "rule-question",
        "max_chars": 6000,
        "fields": {
          "body": {
            "from": "remainder"
          }
        }
      }
    }
  },
  "decision_model": {
    "model": "jev-latest"
  },
  "limits": {
    "evidence_max_chars": 6000,
    "request_max_chars": 131072,
    "max_model_requests": 9000,
    "max_concurrent_requests": 8,
    "max_matches": 20000,
    "max_input_tokens_per_request": 131072
  }
}
